From 20a262e79c83217a1e9001e5e0381ee5085ce88a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E6=B2=90=E9=AA=81?= <lihantian.lht@antgroup.com>
Date: Wed, 30 Sep 2026 03:04:53 +0800
Subject: [PATCH] fix(test): win32 rmSync retry for EPERM in integration
 afterEach

The test daemon's cwd is inside serverDir; Windows needs a beat to
release handles after stop. rmSync maxRetries/retryDelay (win32-only)
runs exactly this race.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 test/test-integration.js | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/test/test-integration.js b/test/test-integration.js
index 15ccfa3..659b4bc 100644
--- a/test/test-integration.js
+++ b/test/test-integration.js
@@ -47,9 +47,12 @@ describe('integration', () => {
       // Ignore
     }
 
-    fs.rmSync(serverDir, { recursive: true, force: true });
-    fs.rmSync(clientDir, { recursive: true, force: true });
-    fs.rmSync(configDir, { recursive: true, force: true });
+    // win32:测试 daemon 的 cwd 就在 serverDir 里,stop 后内核关句柄需要一瞬,
+    // 立刻 rmSync 会撞 EPERM/EBUSY——rmSync 的 maxRetries/retryDelay 仅在
+    // win32 生效,正是为这类锁设计
+    fs.rmSync(serverDir, { recursive: true, force: true, maxRetries: 10, retryDelay: 300 });
+    fs.rmSync(clientDir, { recursive: true, force: true, maxRetries: 10, retryDelay: 300 });
+    fs.rmSync(configDir, { recursive: true, force: true, maxRetries: 10, retryDelay: 300 });
   });
 
   it('syncs files from server to client', async () => {
